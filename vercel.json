{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "app.py": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
